{
  "name": "@pulsar-contracts/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for creating and signing Pulsar PaymentOrders off-chain before submitting to the Soroban smart contract",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/queenannaE/pulsar-contracts.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/queenannaE/pulsar-contracts/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/queenannaE/pulsar-contracts/issues"
  },
  "keywords": [
    "stellar",
    "soroban",
    "pulsar",
    "payments",
    "ed25519",
    "smart-contract",
    "sdk"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "ts-jest": "29.1.4",
    "typescript": "5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
