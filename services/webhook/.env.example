PORT=3001
CONTRACT_ID=YOUR_CONTRACT_ID_HERE
RPC_URL=https://soroban-testnet.stellar.org
POLL_INTERVAL_MS=5000

# Database connection string used to persist webhook registrations.
# Registrations are loaded into memory on startup and written through to this database.
# Example (PostgreSQL): postgres://user:password@localhost:5432/webhooks
# Example (SQLite):     sqlite://./data/webhooks.db
DATABASE_URL=postgres://user:password@localhost:5432/webhooks

# Optional: separate database used by integration tests.
# When set, tests run against this database instead of DATABASE_URL.
# Example (PostgreSQL): postgres://user:password@localhost:5432/webhooks_test
TEST_DATABASE_URL=postgres://user:password@localhost:5432/webhooks_test